{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "health-care-preview",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "health-care-preview-db",
      "database_id": "__HEALTH_PREVIEW_D1_DATABASE_ID__",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "APPLICATION_MANAGEMENT_ORIGIN": "__APPLICATION_MANAGEMENT_PREVIEW_ORIGIN__",
    "HEALTH_DEPLOYMENT_CHANNEL": "cloudflare-preview"
  }
}
